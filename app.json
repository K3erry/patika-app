{
  "expo": {
    "name": "Patika",
    "slug": "patika-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F6E56"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.patika.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F6E56"
      },
      "package": "com.patika.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        { "photosPermission": "Patika needs access to your photos to upload business images." }
      ],
      [
        "expo-notifications",
        { "icon": "./assets/icon.png", "color": "#0F6E56" }
      ]
    ],
    "scheme": "patika",
    "experiments": {
      "typedRoutes": true
    }
  }
}
