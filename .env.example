# -----------------------------------------------
# Patika App — Environment Variables
# -----------------------------------------------
# Copy this to .env and fill in your values.
# In Expo, all public env vars must start with EXPO_PUBLIC_
# -----------------------------------------------

# Your Express backend URL
# Development: your local machine
# Production: your Render URL e.g. https://patika-api.onrender.com/v1
EXPO_PUBLIC_API_URL=http://localhost:5001/v1
